<?xml version="1.0" encoding="utf-8"?>
<layout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
                name="viewModel"
                type="com.hhp227.knu_minigroup.viewmodel.MockTimeTableViewModel" />
    </data>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#eeeeee"
            android:orientation="vertical">

        <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="4dp">

            <com.hhp227.knu_minigroup.ui.TimetableView
                    android:id="@+id/timetable_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:dayLine="@{viewModel.dayLine}"
                    app:timeLine="@{viewModel.timeLine}"
                    app:timetableItems="@{viewModel.itemList}" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</layout>
